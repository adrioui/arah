{
  "name": "arah",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:hot": "node scripts/dev-all.mjs",
    "dev:api": "tsx src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:stop": "fuser -k 8790/tcp 8791/tcp 8792/tcp 5173/tcp 5174/tcp 5175/tcp 2>/dev/null || true",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "pnpm build:web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "lint": "node --import tsx ./node_modules/oxlint/bin/oxlint",
    "test": "vitest run && vitest run --config web/vitest.config.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "start": "node --import tsx src/main.ts"
  },
  "dependencies": {
    "@effect/ai-openai": "4.0.0-rc.112",
    "@effect/platform-browser": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@foldkit/ui": "0.158.1",
    "effect": "4.0.0-rc.112",
    "foldkit": "0.158.1",
    "maplibre-gl": "^6.7.0",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.20.1",
    "@oxlint/plugins": "1.81.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.7.0",
    "fast-check": "^3.23.0",
    "happy-dom": "^20.14.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#e8c4880471b23ab7f216fba7b27d173a6ef07d4c",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "patchedDependencies": {
      "oxlint-plugin-anti-slop@0.1.2": "patches/oxlint-plugin-anti-slop@0.1.2.patch"
    }
  }
}

# Reverse gitignore: ignore everything, then allowlist what we track.
/*
!/.gitignore
!/AGENTS.md
!/CONTEXT.md
!/FOLDKIT.md
!/README.md
!/oxlint.config.ts
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/skills-lock.json
!/tsconfig.json
!/vitest.config.ts
!/scripts/
!/src/
!/test/
!/data/
!/web/
!/patches/
!/.agents/
!/.cursor/

/src/*
!/src/*.ts
!/src/api/
/src/api/*
!/src/api/*.ts
/scripts/*
!/scripts/*.mjs
!/scripts/*.ts
/test/*
!/test/*.ts
/data/*
!/data/routes.json
!/data/observations.json
!/data/places.json
/public/*
/web/*
!/web/index.html
!/web/vite.config.ts
!/web/tsconfig.json
!/web/src/
/web/src/*
!/web/src/**/*.ts
!/web/src/**/*.css
!/web/vitest.config.ts
/web/dist/
/patches/*
!/patches/*.patch
/.agents/*
!/.agents/skills/
/.cursor/*
!/.cursor/skills/
/.agents/skills/*
!/.agents/skills/*/
/.agents/skills/*/*
!/.agents/skills/*/SKILL.md
!/.agents/skills/*/*.md
!/.agents/skills/*/agents/*.yaml
/.cursor/skills/*
!/.cursor/skills/*/
/.cursor/skills/*/*
!/.cursor/skills/*/SKILL.md
!/.cursor/skills/*/*.md
!/.cursor/skills/*/agents/*.yaml
!/web/src/**/*.test.ts
!/web/src/vitest-setup.ts

# Reverse gitignore: ignore everything, then allowlist what we track.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/oxlint.config.ts
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/skills-lock.json
!/tsconfig.json
!/vitest.config.ts
!/src/
!/test/
!/data/
!/public/
!/patches/
!/.agents/
!/.cursor/

/src/*
!/src/*.ts
!/src/api/
/src/api/*
!/src/api/*.ts
/test/*
!/test/*.ts
/data/*
!/data/routes.json
!/data/observations.json
/public/*
!/public/index.html
!/public/app.js
!/public/styles.css
/patches/*
!/patches/*.patch
/.agents/*
!/.agents/skills/
/.cursor/*
!/.cursor/skills/
/.agents/skills/*
!/.agents/skills/*/
/.agents/skills/*/*
!/.agents/skills/*/SKILL.md
/.cursor/skills/*
!/.cursor/skills/*/
/.cursor/skills/*/*
!/.cursor/skills/*/SKILL.md
